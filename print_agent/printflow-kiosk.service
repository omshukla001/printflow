[Unit]
Description=PrintFlow Kiosk Display Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avin
Environment=SERVER_URL=https://your-domain.com
Environment=AGENT_KEY=your-agent-key-here
Environment=SITE_URL=https://your-domain.com
Environment=KIOSK_PORT=5000
ExecStart=/usr/bin/python3 /home/avin/printer_project/print_agent/kiosk_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
